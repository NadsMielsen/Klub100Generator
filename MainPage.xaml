<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Klub100Generator.MainPage">
    <Grid RowDefinitions="*"
          ColumnDefinitions="2*,3*">
        <!-- Left side: Controls -->
        <ScrollView Grid.Column="0">
            <VerticalStackLayout Padding="30,0"
                                 Spacing="25">
                <Button x:Name="SelectCsvBtn"
                        Text="Choose CSV File"
                        Clicked="OnSelectCsvClicked"
                        HorizontalOptions="Fill"/>
                <Button x:Name="DownloadBtn"
                        Text="Download"
                        Clicked="OnDownloadClicked"
                        HorizontalOptions="Fill"/>
                <Button x:Name="TrimAudioBtn"
                        Text="Trim Audio Files"
                        Clicked="OnTrimAudioClicked"
                        HorizontalOptions="Fill"/>
                <Button x:Name="MergeAudioBtn"
                        Text="Merge Cut Files"
                        Clicked="OnMergeAudioClicked"
                        HorizontalOptions="Fill"/>
                <Label x:Name="SelectedFileLabel"
                       Text="No file selected."
                       FontAttributes="Italic"
                       HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Right side: Logs -->
        <Grid Grid.Column="1"
              RowDefinitions="3*,2*"
              Padding="10,10,10,10">
            <!-- Main Info Log -->
            <Border Grid.Row="0"
                    Stroke="Gray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Margin="0,0,0,10"
                    Padding="0">
                <VerticalStackLayout>
                    <Label Text="Info Log"
                           FontAttributes="Bold"
                           FontSize="Medium"
                           Padding="10,5,0,0"/>
                    <Editor x:Name="LogTerminal"
                            IsReadOnly="True"
                            AutoSize="TextChanges"
                            Placeholder="General info log..."
                            HeightRequest="250"
                            MaxLength="1000000"/>
                </VerticalStackLayout>
            </Border>
            <!-- Warnings/Errors Log -->
            <Border Grid.Row="1"
                    Stroke="DarkRed"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="0">
                <VerticalStackLayout>
                    <Label Text="Warnings &amp; Errors"
                           FontAttributes="Bold"
                           FontSize="Medium"
                           TextColor="DarkRed"
                           Padding="10,5,0,0"/>
                    <Editor x:Name="WarnErrorTerminal"
                            IsReadOnly="True"
                            AutoSize="TextChanges"
                            Placeholder="Warnings and errors..."
                            HeightRequest="120"
                            MaxLength="1000000"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>